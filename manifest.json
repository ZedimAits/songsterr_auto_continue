{
  "manifest_version": 3,
  "name": "Songsterr Auto-Continue",
  "version": "1.1.1",
  "description": "Automatically selects Continue with sync pauses in Songsterr.",
  "content_scripts": [
    {
      "matches": [
        "https://songsterr.com/*",
        "https://www.songsterr.com/*"
      ],
      "js": ["songsterr_script.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
