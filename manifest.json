{
  "manifest_version": 3,
  "name": "Songsterr Auto-Continue",
  "version": "1.1.0",
  "description": "Automatically clicks Songsterr's continue link every 100 milliseconds.",
  "content_scripts": [
    {
      "matches": [
        "https://songsterr.com/*",
        "https://www.songsterr.com/*"
      ],
      "js": ["songsterr_script.js"],
      "run_at": "document_start"
    }
  ]
}
